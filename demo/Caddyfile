{
	auto_https disable_redirects
	skip_install_trust
}

https://localhost:8443 {
	tls internal

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' wss://localhost:8443; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	handle /wasm-lab/* {
		reverse_proxy wasm-bridge:8080 {
			header_up X-Lab-Client-IP {http.request.remote.host}
			stream_timeout 3m
		}
	}

	handle {
		root * /srv
		file_server
	}
}
